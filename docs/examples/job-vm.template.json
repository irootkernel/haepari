{
  "schema": "haepari.job/v1",
  "resource_id": "macos-e2e",
  "mode": "auto",
  "suite": "migration",
  "input": {
    "root": "<absolute-prepared-bundle>",
    "inventory_digest": "<sha256>"
  },
  "environment": {
    "profile_id": "<prior-accepted-profile>",
    "profile_digest": "<sha256>"
  },
  "workload": {
    "argv": [
      "make",
      "test-vm-guest",
      "SUITE=migration"
    ],
    "cwd": "source",
    "environment": {
      "HAEPARI_TEST_MODE": "migration"
    },
    "required_outputs": [
      "results/result.json",
      "results/inventory.json"
    ]
  },
  "deadlines": {
    "queue_seconds": 14400,
    "prepare_seconds": 900,
    "run_seconds": 3600,
    "collect_seconds": 300,
    "cleanup_seconds": 900
  },
  "effects": {
    "mode": "offline",
    "authorization_reference": "<approved-job-envelope>"
  },
  "provenance": {
    "candidate_digest": "<sha256>",
    "tests_digest": "<sha256>",
    "target_profile_digest": "<sha256>",
    "evidence_class": "development"
  },
  "execution_mode": "managed"
}
