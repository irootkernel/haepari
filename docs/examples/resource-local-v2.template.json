{
  "schema": "haepari.resource/v2",
  "id": "build-slots",
  "kind": "local",
  "execution_mode": "managed",
  "capacity": 2,
  "revision": 1,
  "adapter": {
    "qualification_reference": "<verified-local-supervision-receipt>"
  },
  "cleanup": {
    "policy_reference": "<operator-owned-cleanup-policy>"
  },
  "lifecycle_budgets": {
    "queue_seconds": 7200,
    "prepare_seconds": 600,
    "run_seconds": 1800,
    "manual_seconds": 3600,
    "collect_seconds": 300,
    "cleanup_seconds": 600
  }
}
