{
  "schema": "haepari.resource/v1",
  "id": "macos-e2e",
  "kind": "utm-macos",
  "capacity": 1,
  "revision": 1,
  "vm": {
    "utm_vm_uuid": "<observed-vm-uuid>",
    "mac_address": "<vm-mac-address>",
    "allow_automatic_stop": false,
    "address_discovery": "dhcp-lease-by-mac",
    "guest_job_root": "<guest-owned-job-root>"
  },
  "adapter": {
    "utmctl": "/Applications/UTM.app/Contents/MacOS/utmctl",
    "qualification_reference": "<verified-backend-receipt>"
  },
  "guest": {
    "connection_reference": "<approved-ssh-mapping>",
    "known_hosts_reference": "sha256:<known-hosts-file-sha256>:<absolute-dedicated-known-hosts-file>"
  },
  "execution_mode": "managed"
}
