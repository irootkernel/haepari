{
  "schema": "haepari.job/v1",
  "resource_id": "build-slots",
  "mode": "auto",
  "suite": "build",
  "input": {
    "root": "<absolute-prepared-bundle>",
    "inventory_digest": "<sha256>",
    "selected_files": ["source/Makefile"]
  },
  "environment": {
    "profile_id": "<local-build-profile>",
    "profile_digest": "<sha256>"
  },
  "workload": {
    "argv": [
      "make",
      "build"
    ],
    "cwd": "source",
    "environment": {},
    "required_outputs": [
      "results/build.json"
    ]
  },
  "deadlines": {
    "queue_seconds": 1800,
    "prepare_seconds": 900,
    "run_seconds": 3600,
    "collect_seconds": 300,
    "cleanup_seconds": 900
  },
  "effects": {
    "mode": "offline",
    "authorization_reference": "<approved-job-envelope>"
  },
  "provenance": {
    "candidate_digest": "<sha256>",
    "tests_digest": "<sha256>",
    "target_profile_digest": "<sha256>",
    "evidence_class": "development"
  },
  "execution_mode": "managed"
}
