{
  "schema": "haepari.config/v1",
  "revision": 1,
  "global_limit": 1,
  "host_macos_guest_limit": 1,
  "default_deadlines": {
    "queue_seconds": 14400,
    "prepare_seconds": 900,
    "run_seconds": 3600,
    "manual_seconds": 7200,
    "collect_seconds": 300,
    "cleanup_seconds": 900
  },
  "limits": {
    "request_bytes": 1048576,
    "log_bytes_per_stream": 268435456,
    "artifact_bytes": 1073741824,
    "artifact_count": 1000,
    "event_retention_days": 30,
    "result_retention_days": 90
  }
}
